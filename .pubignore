# Files excluded from the pub.dev archive.
# NOTE: when .pubignore exists, pub ignores the root .gitignore, so its rules are repeated here.

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
# Libraries should not include pubspec.lock, per https://dart.dev/guides/libraries/private-files#pubspeclock.
*.lock
/.fvm/
**/doc/api/
.dart_tool/
.packages
.flutter-plugins
.flutter-plugins-dependencies
build/

# Claude Code personal settings (shared settings live in .claude/settings.json)
.claude/settings.local.json

# Contributor tooling (not useful to package consumers)
CLAUDE.md
